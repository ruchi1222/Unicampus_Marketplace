<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:main="http://unimart.com/products"
           targetNamespace="http://unimart.com/products"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified">

    <!-- ====GLOBAL SIMPLE TYPES==== -->

    <!-- Product category restriction -->
    <xs:simpleType name="CategoryType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="books"/>
            <xs:enumeration value="stationaries"/>
            <xs:enumeration value="tech"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- ID restrictions by category -->
    <xs:simpleType name="BookIDType">
        <xs:restriction base="xs:string">
            <xs:pattern value="B[0-9]{3}"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="StationeryIDType">
        <xs:restriction base="xs:string">
            <xs:pattern value="S[0-9]{3}"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="TechIDType">
        <xs:restriction base="xs:string">
            <xs:pattern value="T[0-9]{3}"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- Combined ID type -->
    <xs:simpleType name="ProductIDType">
        <xs:union memberTypes="main:BookIDType main:StationeryIDType main:TechIDType"/>
    </xs:simpleType>

    <!-- Name restriction -->
    <xs:simpleType name="ProductNameType">
        <xs:restriction base="xs:string">
            <xs:minLength value="2"/>
            <xs:maxLength value="50"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- Image file restriction -->
    <xs:simpleType name="ImageFileType">
        <xs:restriction base="xs:string">
            <xs:pattern value="[A-Za-z0-9_-]+\.(jpg|jpeg|png|webp)"/>
            <xs:maxLength value="40"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- Description restriction -->
    <xs:simpleType name="DescriptionType">
        <xs:restriction base="xs:string">
            <xs:minLength value="3"/>
            <xs:maxLength value="100"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- Price restriction -->
    <xs:simpleType name="PriceType">
        <xs:restriction base="xs:decimal">
            <xs:minInclusive value="1"/>
            <xs:maxInclusive value="5000"/>
            <xs:totalDigits value="6"/>
            <xs:fractionDigits value="2"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- Optional discount price type -->
    <xs:simpleType name="DiscountPriceType">
        <xs:restriction base="xs:decimal">
            <xs:minInclusive value="1"/>
            <xs:maxInclusive value="5000"/>
            <xs:totalDigits value="6"/>
            <xs:fractionDigits value="2"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- ====GLOBAL COMPLEX TYPES==== -->

    <!-- Product type -->
    <xs:complexType name="ProductType">
        <xs:sequence>
            <xs:element name="id" type="main:ProductIDType"/>
            <xs:element name="name" type="main:ProductNameType"/>
            <xs:element name="image" type="main:ImageFileType"/>
            <xs:element name="description" type="main:DescriptionType"/>

            <!-- Choice included for agenda requirement.
                 Your current XML uses only the 'price' branch. -->
            <xs:choice maxOccurs="1">
                <xs:element name="price" type="main:PriceType"/>
                <xs:element name="discountPrice" type="main:DiscountPriceType"/>
            </xs:choice>
        </xs:sequence>

        <xs:attribute name="category" type="main:CategoryType" use="required"/>
    </xs:complexType>

    <!-- Root type -->
    <xs:complexType name="UnimartType">
        <xs:sequence>
            <xs:element ref="main:product" minOccurs="1" maxOccurs="20"/>
        </xs:sequence>
    </xs:complexType>

    <!-- ====GLOBAL ELEMENTS==== -->

    <xs:element name="product" type="main:ProductType"/>

    <xs:element name="unimart" type="main:UnimartType">
        <!-- Ensures every product id is unique -->
        <xs:key name="uniqueProductID">
            <xs:selector xpath="main:product"/>
            <xs:field xpath="main:id"/>
        </xs:key>
    </xs:element>

</xs:schema>