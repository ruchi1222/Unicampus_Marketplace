<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://unimart.com/products"
           xmlns:main="http://unimart.com/products"
           xmlns:book="http://unimart.com/books"
           xmlns:stn="http://unimart.com/stationaries"
           xmlns:tech="http://unimart.com/tech"
           elementFormDefault="qualified">

    <xs:group name="productElements">
        <xs:sequence>
            <xs:element name="id" type="xs:string"/>
            <xs:element name="name" type="xs:string"/>
            <xs:element name="image" type="xs:string"/>
            <xs:element name="description" type="xs:string"/>
            <xs:element name="price" type="xs:positiveInteger"/>
        </xs:sequence>
    </xs:group>

    <xs:element name="unimart">
        <xs:complexType>
            <xs:choice maxOccurs="unbounded">
                <xs:element name="product" form="unqualified">
                    <xs:complexType>
                        <xs:group ref="main:productElements"/>
                    </xs:complexType>
                </xs:element>
            </xs:choice>
        </xs:complexType>
    </xs:element>

</xs:schema>